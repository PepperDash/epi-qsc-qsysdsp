<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ProjectType>ProgramLibrary</ProjectType>
		<TargetFramework>net8</TargetFramework>
		<RootNamespace>PepperDash.Essentials.Plugins.Qsc.Qsys</RootNamespace>
		<AssemblyName>PepperDash.Essentials.Plugins.Qsc.QsysDsp</AssemblyName>
		<Configurations>Debug;Release</Configurations>
		<Deterministic>false</Deterministic>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyTitle>PepperDash.Essentials.Plugins.Qsc.QsysDsp</AssemblyTitle>
		<Description>This software is a plugin designed to work as a part of PepperDash Essentials for Crestron control processors. This plugin allows for control of QSC Q-SYS DSP.</Description>
		<PackageId>PepperDash.Essentials.Plugins.Qsc.QsysDsp</PackageId>
		<PackageProjectUrl>https://github.com/PepperDash/epi-qsc-qsysdsp</PackageProjectUrl>
		<PackageTags>crestron 4series essentials plugin qsc qsys dsp</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Properties\**" />
		<EmbeddedResource Remove="Properties\**" />
		<None Remove="Properties\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="PepperDashEssentials" Version="3.0.0-rc.6">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
